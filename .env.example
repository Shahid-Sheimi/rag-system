# ---------- Vector DB ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION=knowledge_base

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o                       # any chat model your account has access to
EMBEDDING_PROVIDER=openai              # openai | local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                     # 1536 for text-embedding-3-small, 3072 for -large
# If you change embedding model/dim: delete the Qdrant collection and data/manifest.db, then restart.

# ---------- SQL Server ----------
# Option A: pyodbc (install "Microsoft ODBC Driver 18 for SQL Server")
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@HOST:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Option B: pymssql (no ODBC driver needed)
# DATABASE_URL=mssql+pymssql://USER:PASSWORD@HOST:1433/DBNAME
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23)
SQL_SOURCES_FILE=sql_sources.yaml

# Near-real-time sync via outbox table + triggers (run sql/outbox_sqlserver.sql first)
REALTIME_OUTBOX=true
OUTBOX_TABLE=dbo.rag_outbox
REALTIME_POSTGRES=false

# ---------- Chunking ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
