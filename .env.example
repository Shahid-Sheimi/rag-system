# Copy to .env and fill in values (never commit .env)

# ---------- Vector DB ----------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION=knowledge_base

# ---------- OpenAI ----------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- SQL Server ----------
DATABASE_URL=mssql+pyodbc://USER:PASSWORD@HOST:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
SQL_SOURCES_FILE=sql_sources.yaml
REALTIME_OUTBOX=false
OUTBOX_TABLE=dbo.rag_outbox
REALTIME_POSTGRES=false

# ---------- Chunking ----------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
